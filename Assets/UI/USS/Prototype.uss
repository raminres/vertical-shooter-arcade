.screen, .game-screen {
    flex-grow: 1;
    background-color: rgb(18, 30, 43);
    -unity-font: url("../Fonts/FT_Inter.ttf");
}
.game-screen { background-color: rgba(0, 0, 0, 0); }
.menu { flex-grow: 1; justify-content: center; padding-left: 9%; padding-right: 9%; }
.title { font-size: 126.6px; color: rgb(244, 241, 225); -unity-font: url("../Fonts/FT_Montserrat-SemiBold.ttf"); }
.subtitle { font-size: 37.1px; color: rgb(239, 181, 82); margin-top: 10.9px; margin-bottom: 98.2px; }
.menu-buttons { width: 100%; }
.menu-button, .primary-button {
    height: 126.6px; margin-top: 13.1px; margin-bottom: 13.1px;
    font-size: 43.7px; color: rgb(240, 243, 243);
    background-color: rgb(44, 62, 76);
    border-top-width: 0; border-bottom-width: 0; border-left-width: 0; border-right-width: 0;
}
.menu-button, .primary-button, .pause-button, .special-button {
    scale: 1 1;
    transition-property: scale, background-color;
    transition-duration: 140ms, 140ms;
    transition-timing-function: ease-out-back, ease-out;
}
.menu-button:enabled.mouse-hover, .primary-button:enabled.mouse-hover, .pause-button:enabled.mouse-hover, .special-button:enabled.mouse-hover { scale: 1.025 1.025; }
.menu-button:enabled:active, .primary-button:enabled:active, .pause-button:enabled:active, .special-button:enabled:active { scale: 0.94 0.94; transition-duration: 75ms, 75ms; transition-timing-function: ease-out; }
.primary-button { background-color: rgb(218, 153, 53); color: rgb(22, 31, 38); -unity-font: url("../Fonts/FT_Montserrat-SemiBold.ttf"); }
.menu-button:enabled.mouse-hover, .pause-button:enabled.mouse-hover { background-color: rgb(64, 87, 102); }
.menu-button:enabled:active, .pause-button:enabled:active { background-color: rgb(31, 48, 60); }
.primary-button:enabled.mouse-hover, .special-button:enabled.mouse-hover { background-color: rgb(239, 181, 82); }
.primary-button:enabled:active, .special-button:enabled:active { background-color: rgb(183, 120, 34); }
.menu-button:disabled { opacity: 0.4; }
.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(8, 16, 24, 0.9); justify-content: center; padding-left: 9%; padding-right: 9%; }
.hidden { display: none; }
.dialog { background-color: rgb(27, 43, 56); padding-left: 43.7px; padding-right: 43.7px; padding-top: 48px; padding-bottom: 48px; }
.dialog-title { font-size: 69.9px; color: rgb(244, 241, 225); margin-bottom: 52.4px; -unity-font: url("../Fonts/FT_Montserrat-SemiBold.ttf"); }
.section-label, .body { font-size: 39.3px; color: rgb(221, 229, 230); margin-bottom: 32.8px; white-space: normal; }
.hud-top { flex-direction: row; align-items: flex-start; padding-left: 34.9px; padding-right: 34.9px; padding-top: 34.9px; }
.hud-card { flex-grow: 1; background-color: rgba(15, 29, 40, 0.82); padding-left: 26.2px; padding-right: 26.2px; padding-top: 19.6px; padding-bottom: 19.6px; margin-right: 17.5px; }
.hud-label { color: rgb(196, 207, 208); font-size: 26.2px; }
.hud-value { color: rgb(255, 245, 221); font-size: 48px; -unity-font: url("../Fonts/FT_Montserrat-SemiBold.ttf"); }
.pause-button { width: 117.9px; height: 117.9px; font-size: 48px; color: rgb(255, 245, 221); background-color: rgb(44, 62, 76); }
.hud-bottom { flex-grow: 1; justify-content: flex-end; align-items: flex-end; padding-right: 34.9px; padding-bottom: 43.7px; }
.special-button { width: 338.4px; height: 135.4px; font-size: 34.9px; color: rgb(22, 31, 38); background-color: rgb(218, 153, 53); }
