<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="safe-area" class="screen">
        <Style src="project://database/Assets/UI/USS/Prototype.uss" />
        <ui:VisualElement name="main-panel" class="menu">
            <ui:Label name="title" text="VERTICAL&#10;SHOOTER" class="title" />
            <ui:Label name="subtitle" text="ARCADE" class="subtitle" />
            <ui:VisualElement class="menu-buttons">
                <ui:Button name="new-game" text="New Game" class="primary-button" />
                <ui:Button name="continue" text="Continue" class="menu-button" />
                <ui:Button name="options" text="Options" class="menu-button" />
                <ui:Button name="credits" text="Credits" class="menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="options-panel" class="overlay hidden">
            <ui:VisualElement class="dialog">
                <ui:Label name="options-title" text="Options" class="dialog-title" />
                <ui:Label name="language-label" text="Language" class="section-label" />
                <ui:Button name="english" text="English" class="menu-button" />
                <ui:Button name="turkish" text="Türkçe" class="menu-button" />
                <ui:Button name="options-back" text="Back" class="menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="credits-panel" class="overlay hidden">
            <ui:VisualElement class="dialog">
                <ui:Label name="credits-title" text="Credits" class="dialog-title" />
                <ui:Label name="credits-body" text="A game by Ramin Rasulzade" class="body" />
                <ui:Button name="credits-back" text="Back" class="menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
